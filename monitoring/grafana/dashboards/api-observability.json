{
  "title": "FinGuard API Observability",
  "uid": "finguard-api-observability",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": ["finguard", "api", "phase8"],
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Scoring requests/sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "rate(finguard_scoring_requests_total[5m])", "legendFormat": "requests/sec" }
      ]
    },
    {
      "id": 2,
      "title": "Scoring latency (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(finguard_scoring_latency_seconds_bucket[5m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(finguard_scoring_latency_seconds_bucket[5m]))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, rate(finguard_scoring_latency_seconds_bucket[5m]))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 3,
      "title": "Scoring errors by type",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "rate(finguard_scoring_errors_total[5m])", "legendFormat": "{{error_type}}" }
      ]
    },
    {
      "id": 4,
      "title": "Risk level distribution",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum by (risk_level) (finguard_risk_level_total)", "legendFormat": "{{risk_level}}" }
      ]
    },
    {
      "id": 5,
      "title": "HTTP requests by endpoint and status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "rate(http_requests_total[5m])", "legendFormat": "{{handler}} {{status}}" }
      ]
    },
    {
      "id": 6,
      "title": "Customer risk lookups (found vs. not found)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "rate(finguard_customer_risk_lookups_total[5m])", "legendFormat": "found={{found}}" }
      ]
    }
  ]
}
