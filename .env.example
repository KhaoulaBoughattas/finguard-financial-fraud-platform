# Copy this file to .env and adjust values for your machine.
# NEVER commit the real .env file.

ENV=local
LOG_LEVEL=INFO

# --- PostgreSQL (serving / reference database) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=finguard
POSTGRES_USER=finguard
POSTGRES_PASSWORD=change_me_locally

# --- Kafka ---
# localhost:9092 = the HOST listener (see docs/kafka.md) -- correct for
# anything running on the host machine (CLI, tests, IDE). Code running
# INSIDE a docker-compose service should instead use kafka:19092 (the
# internal PLAINTEXT listener), set via this same env var in that service's
# container environment, not by editing application code.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092

# --- Synthetic data generator defaults ---
GENERATOR_NUM_CUSTOMERS=2000
GENERATOR_NUM_ACCOUNTS=2500
GENERATOR_NUM_MERCHANTS=300
GENERATOR_NUM_TRANSACTIONS=50000
GENERATOR_FRAUD_RATE=0.015
GENERATOR_SEED=42
GENERATOR_OUTPUT_DIR=data/raw

# --- MLflow (Phase 5) ---
ML_MLFLOW_TRACKING_URI=sqlite:///data/mlflow/mlflow.db
ML_EXPERIMENT_NAME=finguard-fraud-detection

# --- Observability (Phase 8) ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change_me_locally
API_PORT=8000
